name: Daily AI News — Auto Generate

on:
  schedule:
    - cron: '0 5 * * *'   # 08:00 Israel time (UTC+3)
  workflow_dispatch:        # Manual trigger for testing

jobs:
  generate:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          direct_prompt: "Generate today's daily AI news document for user: yuvalelazary@gmail.com"
